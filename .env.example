# ==============================================================================
# GravityDesk Unified Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend (Deskmates 3D Virtual Office)
# ------------------------------------------------------------------------------
# Set to 'true' to run fully offline/client-side with synthetic agent simulation.
# Set to 'false' to connect to the Bridge Server over HTTP & WebSocket.
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. Bridge & Provider Gateway (Local Proxy)
# ------------------------------------------------------------------------------
# Bridge HTTP/WebSocket server port
PORT=8000
# Gateway OpenAI-compatible proxy port
GATEWAY_PORT=8787
DESKMATES_BRIDGE=http://127.0.0.1:8787

# ------------------------------------------------------------------------------
# 3. Model Provider Keys (All Free Tier Supported)
# ------------------------------------------------------------------------------
# You only need ONE key to start, or provide several to distribute rate-limit buckets.

# Groq - Fastest inference, free tier (console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter - Free open-weight models with :free tag (openrouter.ai/keys)
OPENROUTER_API_KEY=

# NVIDIA NIM - Free credits for prototyping (build.nvidia.com)
NVIDIA_API_KEY=

# OpenCode Go - Free tier window (opencode.ai/v2/docs/console/go)
GO_API_KEY=

# Optional Extra Providers:
# GOOGLE_AI_STUDIO_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=

# ------------------------------------------------------------------------------
# 4. RealGravity / PAG (Personal Antigravity) Settings
# ------------------------------------------------------------------------------
# Context tier: 1 (aggressive mask), 2 (moderate), 3 (conservative - default)
PAG_CTX_TIER=3

# Optional local/hosted SearXNG instance for autonomous web search
SEARXNG_URL=
