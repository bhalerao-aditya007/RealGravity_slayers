# Real provider keys live ONLY here (bridge/.env, chmod 600, git-ignored). Never paste keys into chat/commits/logs.
# One key per provider. Do NOT farm extra accounts on the same provider to multiply limits (see docs/00_START_HERE.md A1).
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GO_API_KEY=
# optional extra providers (only if you added them to config/providers.yaml + models.yaml)
GOOGLE_AI_STUDIO_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
# optional local fallback (no key): OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
