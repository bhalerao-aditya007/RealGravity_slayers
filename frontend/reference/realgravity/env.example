# RealGravity (PAG) — API Keys
# All providers below offer FREE tiers. No credit card required.
#
# Get your free keys:
#   OpenCode Go : https://opencode.ai/v2/docs/console/go
#   Groq        : https://console.groq.com/keys        (1000 free credits)
#   NVIDIA NIM  : https://build.nvidia.com/             (free prototyping)
#   OpenRouter  : https://openrouter.ai/keys            (free models available)
#
# After editing, copy to .env:
#   cp .env.example .env && chmod 600 .env

# Required: At least ONE provider key must be set
GO_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# SearXNG internal secret (auto-generated by preflight if empty)
SEARXNG_SECRET=
